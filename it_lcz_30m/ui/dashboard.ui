     <widget class="QWidget" name="tabAOI">
      <attribute name="title">
       <string>1. Study Area</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_AOI">
       <item>
        <widget class="QGroupBox" name="groupAOI">
         <property name="title">
